# Vercel AI Gateway key (read automatically by the `ai` package)
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.5

# Mailbox for hello@thezetalabs.xyz
EMAIL_ADDRESS=hello@thezetalabs.xyz
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
IMAP_HOST=
IMAP_PORT=993
IMAP_DRAFTS_FOLDER=Drafts
FROM_NAME=Zeta Labs
SEND_DELAY_SECONDS=30
DAILY_SEND_LIMIT=30

# Optional: set to require this password (HTTP Basic) for the whole app
APP_PASSWORD=
