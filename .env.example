# Vercel AI Gateway (https://vercel.com/ai-gateway)
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=anthropic/claude-sonnet-4.5

# Mailbox for hello@thezetalabs.xyz (use your provider's IMAP/SMTP details + app password)
EMAIL_ADDRESS=hello@thezetalabs.xyz
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
IMAP_HOST=
IMAP_PORT=993
IMAP_DRAFTS_FOLDER=Drafts

FROM_NAME=Zeta Labs
SEND_DELAY_SECONDS=60
DAILY_SEND_LIMIT=30
